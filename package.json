{
  "name": "cerberus-poker",
  "version": "0.1.0",
  "private": true,
  "description": "Solana SDK for multiplayer card games with complete information privacy via Arcium MPC and Confidential SPL tokens",
  "workspaces": [
    "packages/sdk/core",
    "packages/sdk/deck",
    "packages/sdk/wager",
    "examples/poker-ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "dev": "npm run dev:ui",
    "dev:validator": "solana-test-validator --reset",
    "dev:programs": "cd packages/programs && anchor build && anchor deploy",
    "dev:ui": "npm run dev --workspace=examples/poker-ui",
    "start": "npm run dev",
    "setup:local": "node scripts/setup-local.js",
    "deploy:local": "cd packages/programs && anchor build && anchor deploy",
    "verify": "bash scripts/verify-setup.sh",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
